{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model-change-assessment.schema.json",
  "title": "Model Change Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "model_path",
    "baseline",
    "current",
    "observed_changes",
    "declared_behavior_classes",
    "declaration_consistent"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "model_path": {"type": "string", "minLength": 1},
    "baseline": {"$ref": "#/$defs/model"},
    "current": {"$ref": "#/$defs/model"},
    "observed_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["content_hash", "version", "model_card"]}
    },
    "declared_behavior_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "declaration_consistent": {"type": "boolean"}
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bom_ref", "version", "sha256"],
      "properties": {
        "bom_ref": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
