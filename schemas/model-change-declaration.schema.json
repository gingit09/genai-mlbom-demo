{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model-change-declaration.schema.json",
  "title": "Model Change Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "model_path",
    "from_version",
    "to_version",
    "behavior_classes",
    "summary",
    "declared_by",
    "declared_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change_id": {"type": "string", "minLength": 1},
    "model_path": {"type": "string", "minLength": 1},
    "from_version": {"type": "string", "minLength": 1},
    "to_version": {"type": "string", "minLength": 1},
    "behavior_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "model_weights",
          "safety_guardrails",
          "clinical_content",
          "output_format",
          "input_contract",
          "training_data",
          "unknown"
        ]
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "declared_by": {"type": "string", "minLength": 1},
    "declared_at": {"type": "string", "format": "date-time"}
  }
}
